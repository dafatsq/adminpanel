<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-box-seam-fill"></i> Detail Produk</span>
                <div class="btn-group btn-group-sm">
                    <a href="/products/{{product.id}}/edit" class="btn btn-warning"><i class="bi bi-pencil"></i>
                        Edit</a>
                    <form method="POST" action="/products/{{product.id}}/delete" style="display:inline"
                        onsubmit="return confirm('Yakin hapus produk ini?')">
                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Hapus</button>
                    </form>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <th style="width:150px">ID</th>
                        <td>{{product.id}}</td>
                    </tr>
                    <tr>
                        <th>Nama</th>
                        <td class="fw-semibold">{{product.name}}</td>
                    </tr>
                    <tr>
                        <th>Deskripsi</th>
                        <td>{{product.description}}</td>
                    </tr>
                    <tr>
                        <th>Kategori</th>
                        <td><a href="/categories/{{product.category.id}}"
                                class="badge-category text-decoration-none">{{product.category.name}}</a></td>
                    </tr>
                    <tr>
                        <th>Harga</th>
                        <td class="fw-semibold text-success">{{formatPrice product.price}}</td>
                    </tr>
                    <tr>
                        <th>Stok</th>
                        <td>
                            {{#if (eq product.stock 0)}}
                            <span class="badge bg-danger">Habis</span>
                            {{else}}
                            <span class="badge bg-success">{{product.stock}} unit</span>
                            {{/if}}
                        </td>
                    </tr>
                    <tr>
                        <th>Tanggal Dibuat</th>
                        <td>{{formatDate product.createdAt}}</td>
                    </tr>
                    <tr>
                        <th>Terakhir Diubah</th>
                        <td>{{formatDate product.updatedAt}}</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="/products" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Kembali ke Daftar</a>
</div>