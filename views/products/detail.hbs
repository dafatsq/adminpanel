<div class="card">
    <div class="card-header d-flex justify-content-between">
        <h5 class="mb-0">Detail Produk</h5>
        <div>
            <a href="/products/{{ product.id }}/edit" class="btn btn-sm btn-warning">Edit</a>
            <a href="/products" class="btn btn-sm btn-secondary">Kembali</a>
        </div>
    </div>
    <div class="card-body">
        <table class="table">
            <tr>
                <th width="200">ID</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Nama</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Deskripsi</th>
                <td>{{ product.description }}</td>
            </tr>
            <tr>
                <th>Harga</th>
                <td>{{ formatPrice product.price }}</td>
            </tr>
            <tr>
                <th>Stok</th>
                <td>{{ product.stock }}</td>
            </tr>
            <tr>
                <th>Kategori</th>
                <td>
                    {{#if product.category}}
                    <a href="/categories/{{ product.category.id }}">{{ product.category.name }}</a>
                    {{else}}
                    -
                    {{/if}}
                </td>
            </tr>
            <tr>
                <th>Tanggal Dibuat</th>
                <td>{{ formatDate product.createdAt }}</td>
            </tr>
            <tr>
                <th>Terakhir Diupdate</th>
                <td>{{ formatDate product.updatedAt }}</td>
            </tr>
        </table>
    </div>
</div>