{{#if success}}
<div class="alert alert-success">{{ success }}</div>
{{/if}}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Daftar Produk</h5>
        <div class="d-flex gap-2">
            <form method="GET" action="/products" class="d-flex">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Cari produk..."
                    value="{{ search }}">
                <button type="submit" class="btn btn-sm btn-outline-primary ms-2">Cari</button>
            </form>
            <a href="/products/create" class="btn btn-sm btn-primary">+ Tambah</a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nama</th>
                    <th>Kategori</th>
                    <th>Harga</th>
                    <th>Stok</th>
                    <th>Tanggal Dibuat</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                {{#each products}}
                <tr>
                    <td>{{ this.id }}</td>
                    <td>{{ this.name }}</td>
                    <td>
                        {{#if this.category}}
                        <span class="badge bg-secondary">{{ this.category.name }}</span>
                        {{/if}}
                    </td>
                    <td>{{ formatPrice this.price }}</td>
                    <td>{{ this.stock }}</td>
                    <td>{{ formatDate this.createdAt }}</td>
                    <td>
                        <a href="/products/{{ this.id }}" class="btn btn-sm btn-info">Detail</a>
                        <a href="/products/{{ this.id }}/edit" class="btn btn-sm btn-warning">Edit</a>
                        <form method="POST" action="/products/{{ this.id }}/delete" class="d-inline"
                            onsubmit="return confirm('Yakin hapus?')">
                            <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        {{#unless products.length}}
        <p class="text-center text-muted">Tidak ada data produk</p>
        {{/unless}}
    </div>
</div>