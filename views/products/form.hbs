<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-box-seam-fill"></i> {{title}}
            </div>
            <div class="card-body">
                {{#if errors}}
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i> <strong>Validasi gagal:</strong>
                    <ul class="mb-0 mt-1">
                        {{#each errors}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}

                <form method="POST" action="{{#if product.id}}/products/{{product.id}}{{else}}/products{{/if}}">
                    <div class="mb-3">
                        <label for="name" class="form-label">Nama Produk <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" name="name" value="{{product.name}}" required>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Deskripsi</label>
                        <textarea class="form-control" id="description" name="description"
                            rows="3">{{product.description}}</textarea>
                    </div>
                    <div class="mb-3">
                        <label for="categoryId" class="form-label">Kategori <span class="text-danger">*</span></label>
                        <select class="form-select" id="categoryId" name="categoryId" required>
                            <option value="">-- Pilih Kategori --</option>
                            {{#each categories}}
                            <option value="{{this.id}}" {{selected this.id ../product.categoryId}}>{{this.name}}
                            </option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="price" class="form-label">Harga (Rp) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="price" name="price" value="{{product.price}}"
                                min="0" step="1000" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="stock" class="form-label">Stok <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="stock" name="stock" value="{{product.stock}}"
                                min="0" required>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> {{#if product.id}}Perbarui{{else}}Simpan{{/if}}
                        </button>
                        <a href="/products" class="btn btn-outline-secondary">Batal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>