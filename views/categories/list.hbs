{{#if success}}
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill"></i> {{success}}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{{/if}}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span><i class="bi bi-tags-fill"></i> Daftar Kategori</span>
        <div class="d-flex gap-2 flex-wrap">
            <form method="GET" action="/categories" class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Cari kategori..."
                    value="{{search}}">
            </form>
            <a href="/categories/create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg"></i> Tambah
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:60px">#</th>
                        <th>Nama</th>
                        <th>Deskripsi</th>
                        <th>Jumlah Produk</th>
                        <th>Tanggal Dibuat</th>
                        <th style="width:150px">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each categories}}
                    <tr>
                        <td>{{this.id}}</td>
                        <td><a href="/categories/{{this.id}}" class="text-decoration-none fw-semibold">{{this.name}}</a>
                        </td>
                        <td class="text-muted">{{this.description}}</td>
                        <td><span class="badge bg-primary bg-opacity-10 text-primary">{{this.products.length}}
                                produk</span></td>
                        <td>{{formatDate this.createdAt}}</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a href="/categories/{{this.id}}" class="btn btn-outline-info" title="Detail"><i
                                        class="bi bi-eye"></i></a>
                                <a href="/categories/{{this.id}}/edit" class="btn btn-outline-warning" title="Edit"><i
                                        class="bi bi-pencil"></i></a>
                                <form method="POST" action="/categories/{{this.id}}/delete" style="display:inline"
                                    onsubmit="return confirm('Yakin hapus kategori ini?')">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Hapus"><i
                                            class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                    {{#unless categories.length}}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            {{#if search}}Tidak ada kategori yang cocok dengan "{{search}}"{{else}}Belum ada
                            kategori{{/if}}
                        </td>
                    </tr>
                    {{/unless}}
                </tbody>
            </table>
        </div>
    </div>
</div>