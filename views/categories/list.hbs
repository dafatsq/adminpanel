{{#if success}}
<div class="alert alert-success">{{ success }}</div>
{{/if}}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Daftar Kategori</h5>
        <div class="d-flex gap-2">
            <form method="GET" action="/categories" class="d-flex">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Cari kategori..."
                    value="{{ search }}">
                <button type="submit" class="btn btn-sm btn-outline-primary ms-2">Cari</button>
            </form>
            <a href="/categories/create" class="btn btn-sm btn-primary">+ Tambah</a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nama</th>
                    <th>Deskripsi</th>
                    <th>Jumlah Produk</th>
                    <th>Tanggal Dibuat</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                {{#each categories}}
                <tr>
                    <td>{{ this.id }}</td>
                    <td>{{ this.name }}</td>
                    <td>{{ this.description }}</td>
                    <td><span class="badge bg-info">{{ this.products.length }}</span></td>
                    <td>{{ formatDate this.createdAt }}</td>
                    <td>
                        <a href="/categories/{{ this.id }}" class="btn btn-sm btn-info">Detail</a>
                        <a href="/categories/{{ this.id }}/edit" class="btn btn-sm btn-warning">Edit</a>
                        <form method="POST" action="/categories/{{ this.id }}/delete" class="d-inline"
                            onsubmit="return confirm('Yakin hapus?')">
                            <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        {{#unless categories.length}}
        <p class="text-center text-muted">Tidak ada data kategori</p>
        {{/unless}}
    </div>
</div>