<div class="card">
    <div class="card-header d-flex justify-content-between">
        <h5 class="mb-0">Detail Kategori</h5>
        <div>
            <a href="/categories/{{ category.id }}/edit" class="btn btn-sm btn-warning">Edit</a>
            <a href="/categories" class="btn btn-sm btn-secondary">Kembali</a>
        </div>
    </div>
    <div class="card-body">
        <table class="table">
            <tr>
                <th width="200">ID</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Nama</th>
                <td>{{ category.name }}</td>
            </tr>
            <tr>
                <th>Deskripsi</th>
                <td>{{ category.description }}</td>
            </tr>
            <tr>
                <th>Tanggal Dibuat</th>
                <td>{{ formatDate category.createdAt }}</td>
            </tr>
            <tr>
                <th>Terakhir Diupdate</th>
                <td>{{ formatDate category.updatedAt }}</td>
            </tr>
        </table>
    </div>
</div>

<!-- Produk dalam kategori ini -->
{{#if category.products.length}}
<div class="card mt-3">
    <div class="card-header">
        <h6 class="mb-0">Produk di Kategori Ini ({{ category.products.length }})</h6>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nama</th>
                    <th>Harga</th>
                    <th>Stok</th>
                </tr>
            </thead>
            <tbody>
                {{#each category.products}}
                <tr>
                    <td><a href="/products/{{ this.id }}">{{ this.name }}</a></td>
                    <td>{{ formatPrice this.price }}</td>
                    <td>{{ this.stock }}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
{{/if}}